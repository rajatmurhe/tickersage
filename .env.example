# Copy to .env and fill in what you have. Everything works offline with no keys
# (rules router + template answers), which is also how CI runs the replay evals.

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Alternative to the two above: one OpenRouter key runs the same Claude models (and GPT ones).
# With only this key set, OpenRouter becomes the primary provider automatically.
OPENROUTER_API_KEY=
# Or a free NVIDIA key (build.nvidia.com, starts with nvapi-): Nemotron models, rate-limited, $0.
NVIDIA_API_KEY=
# Free Groq key (console.groq.com, starts with gsk_): fast gpt-oss models, tried first when the primary stalls.
GROQ_API_KEY=
# auto = live if any key is set, otherwise offline
LLM_MODE=auto
# anthropic | openai | openrouter | nvidia | groq  (the others with a key are the fallbacks). Blank = pick from the keys.
PRIMARY_PROVIDER=
# routed = Haiku for routing/simple lookups, Sonnet for analysis; single = Sonnet everywhere
ROUTING_MODE=routed
# rules | llm
PLANNER_MODE=rules

# Tools: live | replay | record
TOOL_MODE=live

# Optional infrastructure (falls back to in-memory cache and SQLite when unset)
REDIS_URL=
DATABASE_URL=sqlite:///./tickersage.db
# memory | pgvector
DOCS_BACKEND=memory
PGVECTOR_URL=
# hash | openai
EMBEDDING_PROVIDER=hash

# Browser access: deployed frontend origins as a JSON list (any localhost port is always allowed)
CORS_ORIGINS=[]

# Public demo guards: all off by default (README: "Deploying a public demo")
# Questions per client IP on /api/chat and /api/chat/stream; 0 = unlimited
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_PER_DAY=0
# true only behind a proxy that appends the client IP to X-Forwarded-For (Render, Fly, nginx)
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
# USD: once today's (UTC) traced LLM cost reaches this, answers run offline until midnight UTC; blank = no cap
DAILY_BUDGET_USD=
# When set, /api/traces and /api/refusals need an X-Admin-Token header (they show users' questions)
ADMIN_TOKEN=
